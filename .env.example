# Скопируйте в .env и при необходимости отредактируйте.

# Путь к SQLite-файлу (по умолчанию data/todo.db в папке проекта).
# На хостинге с постоянным диском укажите путь к примонтированному тому.
# TODO_DB_PATH=/var/data/todo.db

# Альтернативно — строка подключения к реляционной БД (PostgreSQL, MySQL...).
# Если задано, переопределяет TODO_DB_PATH.
# TODO_DATABASE_URL=postgresql://user:password@host:5432/dbname

